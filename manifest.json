{
  "id": "quests_base",
  "name": "Quests Engine",
  "version": "1.0.0",
  "author": "ct",
  "description": "Quests engine: quests with numbered steps that scenarios start, advance and finish, and the journal panel that shows them.",
  "category": "engine, library",
  "sources": [
    "src/**/*.cs"
  ],
  "test_sources": ["tests/*.cs"],
  "depends": ["characters_base>=1", "ui_base>=1"],
  "ui": [
    {
      "id": "journal",
